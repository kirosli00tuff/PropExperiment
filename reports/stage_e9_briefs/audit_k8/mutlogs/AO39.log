    def test_ddof_1_end_to_end_just_below_2_does_not_trade() -> None:
        """On base B + 1 a +1 step is r = 1/6001: z = 1.99967 with ddof 1 (no trade); ddof 0 would
        give 2.00067 (a trade)."""
        values = ref_values(STANDARD)
