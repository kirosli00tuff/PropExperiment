 "proposed_features": [
  {
   "name": "zs_wasde_post_t4",
   "source": "Anderson, McKenzie, Noyes (2024), NCCC-134 (E2)",
   "quote": "Soy News -0.028 -0.061** -0.124** ... the soybean price reaction grows after 30 minutes.",
   "formula": "on WASDE date d at t4=12:18 CT: x = (close(ZS 12:17 bar of d) - close(ZS 10:59 bar of d)) / tick, same instrument_id; else 0 with flag 0",
   "decision_times": [
    "t4"
   ],
   "horizons": [
    "h60",
    "F"
   ],
   "legs": [
    "ZS"
   ],
   "calendars": [
    "WASDE dates (11:00 CT release)",
    "grains group calendar"
   ],
   "available_both_windows": false,
   "expected_gross_per_trade_ticks": 3.8,
   "derivation": "UPPER BOUND with perfect news sign: |beta_day-beta_30| x E|news| = 0.063 x 0.798 x 0.029 = 14.6 bp over ~11:30-13:15; x 57/105 (t4 window, linear drift assumed) = 7.9 bp; at $12.00/bu [unverified assumption] = 0.95 c = 3.80 ticks ($47.5). Bar-only proxy scales by (2p-1), p unknown; 1.5x needs p >= 0.82. 2010-2019 WASDE calendar absent; 11:00 CT release only from Jan 2013.",
   "d8_rt_ticks": 1.644,
   "ratio_to_d8": 2.31,
   "clears_1p5x": false
  }
 ],
